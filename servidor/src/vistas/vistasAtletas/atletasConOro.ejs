<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <title>Atletas con oro</title>
</head>
<body>
    <header>
        <nav>
            <ul class="menuConsultas">
                <a href="/atletas">VOLVER</a>
            </ul>
        </nav>
    </header>
    <h1>ATLETAS CON MEDALLAS DE ORO</h1>
    <table>
        <thead>
            <tr>
                <th>ID PARTICIPACION</th>
                <th>ATLETA</th>
                <th>EVENTO</th>
                <th>AÑO</th>
                <th>MEDALLA</th>
            </tr>
        </thead>
        <tbody>
        <% if (atletas.length === 0) { %>
            <tr>
                <td colspan="7" style="text-align: center;">No se encontraron atletas</td>
            </tr>
        <% } else{ %>
        <% atletas.forEach (atleta => { %>
            <tr>
                <td> <%= atleta.idparticipacion %></td>
                <td> <%= atleta.nombre %></td>
                <td> <%= atleta.descripcion %></td>
                <td> <%= atleta.anio %></td>
                <td> <%= atleta.medalla %></td>
            </tr>         
        <% }); %>
        <% } %>
        </tbody>
    </table>

    <% if ( typeof alertaError !== 'undefined' && alertaError) { %>
    <script>
        Swal.fire({
            icon: "error",
            title: "ERROR",
            text: "Algo salió mal :C",
            });
    </script>
    <% } %>
</body>
</html>
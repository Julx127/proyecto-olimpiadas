<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <title>Crear atleta</title>
</head>
<body>
    <header>
        <nav>
            <ul class="menuPrincipal">
                <a href="/atletas">VOLVER</a>
            </ul>
        </nav>
    </header>
    <h1>CREAR ATLETA</h1>
    <form action="/atletas/crearAtletasSQL" method="POST">
        <input name="nombrePais" type="text" placeholder="Nombre del pais" maxlength="50" size="15" required>
        <input name="nombre" type="text" placeholder="Nombre Completo" maxlength="100" size="15" required>
        <select name="genero" required>
            <option value="Femenino">Femenino</option>
            <option value="Masculino">Masculino</option>
        </select>
        <input name="edad" type="number" placeholder="Edad" maxlength="2" size="15" required>
        <input name="estatura" type="text" placeholder="Estatura (metros)" size="15" required>
        <input name="peso" type="text" placeholder="Peso (KG)" size="15" required>
        <button name="enviar" type="submit">Registrar</button>
    </form>

<% if ( typeof alertaError !== 'undefined' && alertaError) { %>
    
<script>
    Swal.fire({
        icon: "error",
        title: "ERROR",
        text: "Algo salió mal :C",
        });
</script>

<% } %>
</body>
</html>
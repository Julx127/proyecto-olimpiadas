<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/estilos.css">
    <title>Promedios de peso y estatura</title>
</head>
<body>
    <header>
        <nav>
            <ul class="menuConsultas">
                <a href="/atletas">VOLVER</a>
            </ul>
        </nav>
    </header>
    <h1>PROMEDIOS DE PESO Y ESTATURA</h1>
    <% let promedioPeso=0, promedioAltura=0; %>
    <% if (atletas.length === 0) { %>

        <p style="text-align: center;">No se encontraron atletas</p>

        <% } else{ %>
        <% atletas.forEach (atleta => { %>
            
                <% promedioPeso= promedioPeso+Number(atleta.peso) %>
                <% promedioAltura= promedioAltura+Number(atleta.estatura) %>
        <% }); %>
            <p style="text-align: center; padding: 10px; font-size: 30px;">PROMEDIO PESO: <%= promedioPeso/atletas.length %>kg</p>
            <p style="text-align: center; padding: 10px; font-size: 30px;">PROMEDIO ALTURA: <%= promedioAltura/atletas.length %>m</p>
        <% } %>
        </tbody>
    </table>

    <% if ( typeof alertaError !== 'undefined' && alertaError) { %>
    <script>
        Swal.fire({
            icon: "error",
            title: "ERROR",
            text: "Algo salió mal :C",
            });
    </script>
    <% } %>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <title>Eliminar deportes</title>
</head>
<body>
    <header>
        <nav>
            <ul class="menuPrincipal">
                <a href="/deportes">VOLVER</a>
            </ul>
        </nav>
    </header>
    <h1>ELIMINAR DEPORTES</h1>

    <form action="/deportes/eliminarDeportes" method="GET">
        <input name="nombre" type="text" placeholder="Nombre del deporte" size="15">
        <button name="enviar" type="submit">BUSCAR</button>
    </form>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>NOMBRE</th>
            </tr>
        </thead>
        <tbody>
        <% if (deportes.length === 0) { %>
            <tr>
                <td colspan="2" style="text-align: center;">No se encontraron deportes</td>
            </tr>
        <% } else{ %>
        <% deportes.forEach(deporte => { %>
            <tr>
                <td> <%= deporte.iddeporte %></td>
                <td> <%= deporte.nombre %></td>
            </tr>         
        <% }); %>
        <% } %>
        </tbody>
    </table>

    <form id="formularioEliminar" action="/deportes/eliminarDeportesSQL" method="POST" onsubmit="confirmarEliminacion(event)">
        <input name="id" type="number" placeholder="ID del deporte" size="15" required>
        <button name="enviar" type="submit" style="background-color: rgb(190, 90, 90); color: white;">ELIMINAR</button>
    </form>

<script>
    function confirmarEliminacion(evento){
        evento.preventDefault(); 
        const formulario=evento.target; 
        Swal.fire({
            title: "ESTAS SEGURO?",
            text: "Esta acción no se podrá revertir",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Eliminar",
            cancelButtonText: "Cancelar"
        }).then((result) => {
        if (result.isConfirmed) {
            formulario.submit(); 
        }
        });
    }
</script>

<% if ( typeof alertaExito !== 'undefined' && alertaExito) { %>
    <script>
        Swal.fire({
            icon: "success",
            title: "EXITOS!",
            text: "Se elimino el deporte correctamente",
            });
    </script>
    <% } %>

    <% if ( typeof alertaError !== 'undefined' && alertaError) { %>
    <script>
        Swal.fire({
            icon: "error",
            title: "ERROR",
            text: "Algo salió mal :C",
            });
    </script>
    <% } %>
</body>
</html>
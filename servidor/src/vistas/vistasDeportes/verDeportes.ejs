<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <title>Ver y buscar deportes</title>
</head>
<body>
    <header>
        <nav>
            <ul class="menuPrincipal">
                <a href="/deportes">VOLVER</a>
            </ul>
        </nav>
    </header>
    <h1>VER Y BUSCAR DEPORTES</h1>
    <form action="/deportes/verDeportes" method="GET">
        <input name="id" type="number" placeholder="ID del deporte" size="15">
        <button name="enviar" type="submit">BUSCAR</button>
    </form>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>NOMBRE</th>
            </tr>
        </thead>
        <tbody>
        <% if (deportes.length === 0) { %>
            <tr>
                <td colspan="2" style="text-align: center;">No se encontraron deportes</td>
            </tr>
        <% } else{ %>
        <% deportes.forEach(deporte => { %>
            <tr>
                <td> <%= deporte.iddeporte %></td>
                <td> <%= deporte.nombre %></td>
            </tr>         
        <% }); %>
        <% } %>
        </tbody>
    </table>

    <% if ( typeof alertaError !== 'undefined' && alertaError) { %>
    <script>
        Swal.fire({
            icon: "error",
            title: "ERROR",
            text: "Algo salió mal :C",
            });
    </script>
    <% } %>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/estilos.css">
    <title>Crear eventos</title>
</head>
<body>
    <header>
        <nav>
            <ul class="menuPrincipal">
                <a href="/eventos">VOLVER</a>
            </ul>
        </nav>
    </header>
    <h1>CREAR EVENTOS</h1>
    <form action="/eventos/crearEventosSQL" method="POST">
        <input name="deporte" type="text" placeholder="Nombre del Deporte" maxlength="45" size="15" required>
        <input name="descripcion" type="text" placeholder="Descripcion" maxlength="100" size="15" required>
        <button name="enviar" type="submit">Registrar</button>
    </form>
</body>
</html>
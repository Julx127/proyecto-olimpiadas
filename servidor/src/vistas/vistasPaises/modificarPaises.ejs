<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <title>Modificar paises</title>
</head>
<body>
    <header>
        <nav>
            <ul class="menuPrincipal">
                <a href="/paises">VOLVER</a>
            </ul>
        </nav>
    </header>
    <h1>MODIFICAR PAISES</h1>
    <form action="/paises/modificarPaises" method="GET">
        <input name="nombre" type="text" placeholder="Nombre del pais" size="15">
        <button name="enviar" type="submit">BUSCAR</button>
    </form>

    <form id="formularioModificar" action="/paises/modificarPaisesSQL" method="POST" onsubmit="confirmarModificacion(event)">
        <input name="ISO" type="text" placeholder="ISO" size="15" readonly required value="<%= typeof paises.length !== 'undefined' && paises.length > 0 ? paises[0].ISO : '' %>">
        <input name="nombre" type="text" placeholder="Nombre del pais" size="20"  required value="<%= typeof paises.length !== 'undefined' && paises.length > 0 ? paises[0].nombre : '' %>">
        <select name="continente"> 
            <!--Primero guardo el continente devuelvto de la bd, y despues lo comparo con todas las opciones para ver cual dejar como seleccionada-->
            <% let continenteActual = typeof paises.length !== 'undefined' && paises.length > 0 ? paises[0].continente : ''; %>
            <option value="America del Norte" <%= continenteActual === 'America del Norte' ? 'selected' : '' %>>America del Norte</option>
            <option value="America del Sur" <%= continenteActual === 'America del Sur' ? 'selected' : '' %>>America del Sur</option>
            <option value="America Central" <%= continenteActual === 'America Central' ? 'selected' : '' %>>America Central</option>
            <option value="Europa" <%= continenteActual === 'Europa' ? 'selected' : '' %>>Europa</option>
            <option value="Asia" <%= continenteActual === 'Asia' ? 'selected' : '' %>>Asia</option>
            <option value="Africa" <%= continenteActual === 'Africa' ? 'selected' : '' %>>Africa</option>
            <option value="Oceania" <%= continenteActual === 'Oceania' ? 'selected' : '' %>>Oceania</option>
        </select>
        <button name="enviar" type="submit" style="background-color: rgb(114, 43, 110); color: white;">MODIFICAR</button>
    </form>

<script> 
    function confirmarModificacion(evento){
        evento.preventDefault(); 
        const formulario=evento.target;
        const idInput = document.querySelector('input[name="ISO"]');
        
        if (!idInput.value.trim()) {
            Swal.fire({
            icon: "error",
            title: "ERROR",
            text: "El ISO del pais está vacío, busca un pais antes de modificarlo",
            });
            return false;
        }

        Swal.fire({
            title: "ESTAS SEGURO?",
            text: "Esta acción no se podrá revertir",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Modificar",
            cancelButtonText: "Cancelar"
        }).then((result) => {
        if (result.isConfirmed) {
            formulario.submit(); 
        }
        });
    }
</script>

<% if ( typeof alertaExito !== 'undefined' && alertaExito) { %>
    <script>
        Swal.fire({
            icon: "success",
            title: "EXITOS!",
            text: "Se modificó el pais correctamente",
            });
    </script>
    <% } %>

    <% if ( typeof alertaError !== 'undefined' && alertaError) { %>
    <script>
        Swal.fire({
            icon: "error",
            title: "ERROR",
            text: "Algo salió mal :C",
            });
    </script>
    <% } %>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <title>Ver y buscar paises</title>
</head>
<body>
    <header>
        <nav>
            <ul class="menuPrincipal">
                <a href="/paises">VOLVER</a>
            </ul>
        </nav>
    </header>
    <h1>VER Y BUSCAR PAISES</h1>
    <form action="/paises/verPaises" method="GET">
        <input name="nombre" type="text" placeholder="Nombre del país" size="15">
        <button name="enviar" type="submit">BUSCAR</button>
    </form>
    <table>
        <thead>
            <tr>
                <th>ISO</th>
                <th>NOMBRE</th>
                <th>CONTINENTE</th>
            </tr>
        </thead>
        <tbody>
        <% if (paises.length === 0) { %>
            <tr>
                <td colspan="3" style="text-align: center;">No se encontraron paises</td>
            </tr>
        <% } else{ %>
        <% paises.forEach(pais => { %>
            <tr>
                <td> <%= pais.ISO %></td>
                <td> <%= pais.nombre %></td>
                <td> <%= pais.continente %></td>
            </tr>         
        <% }); %>
        <% } %>
        </tbody>
    </table>

    <% if ( typeof alertaError !== 'undefined' && alertaError) { %>
    <script>
        Swal.fire({
            icon: "error",
            title: "ERROR",
            text: "Algo salió mal :C",
            });
    </script>
    <% } %>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <title>Modificar participaciones</title>
</head>
<body>
    <header>
        <nav>
            <ul class="menuPrincipal">
                <a href="/participaciones">VOLVER</a>
            </ul>
        </nav>
    </header>
    <h1>MODIFICAR PARTICIPACIONES</h1>

    <form action="/participaciones/modificarParticipaciones" method="GET">
        <input name="id" type="number" placeholder="ID de la participación" size="15">
        <button name="enviar" type="submit">BUSCAR</button>
    </form>
    
    <form id="formularioModificar" action="/participaciones/modificarParticipacionesSQL" method="POST" onsubmit="confirmarModificacion(event)">
        <input name="id" type="text" placeholder="ID de la participación" size="15" readonly required value="<%= typeof participaciones.length !== 'undefined' && participaciones.length > 0 ? participaciones[0].idparticipacion : '' %>">
        <input name="nombre" type="text" placeholder="Nombre del atleta" size="20"  required value="<%= typeof participaciones.length !== 'undefined' && participaciones.length > 0 ? participaciones[0].nombre : '' %>">
        <input name="evento" type="text" placeholder="Nombre del evento" size="20"  required value="<%= typeof participaciones.length !== 'undefined' && participaciones.length > 0 ? participaciones[0].descripcion : '' %>">
        <input name="anio" type="number" placeholder="Año de la participación" size="20"  required value="<%= typeof participaciones.length !== 'undefined' && participaciones.length > 0 ? participaciones[0].anio : '' %>">
        <select name="medalla" required>
            <% let medallaActual = typeof participaciones.length !== 'undefined' && participaciones.length > 0 ? participaciones[0].medalla : ''; %>
            <option value="NULL" <%= medallaActual === 'NULL' ? 'selected' : '' %>>Sin medalla</option>
            <option value="Oro" <%= medallaActual === 'Oro' ? 'selected' : '' %>>Medalla de oro</option>
            <option value="Plata" <%= medallaActual === 'Plata' ? 'selected' : '' %>>Medalla de plata</option>
            <option value="Bronce" <%= medallaActual === 'Bronce' ? 'selected' : '' %>>Medalla de Bronce</option>
        </select>
        <button name="enviar" type="submit" style="background-color: rgb(114, 43, 110); color: white;">MODIFICAR</button>
    </form>

    <script> 
    function confirmarModificacion(evento){
        evento.preventDefault(); 
        const formulario=evento.target;
        const idInput = formulario.querySelector('input[name="id"]'); 
        
        if (!idInput.value.trim()) {
            Swal.fire({
            icon: "error",
            title: "ERROR",
            text: "El ID de la participación está vacío, busca una participación antes de modificarla",
            });
            return false;
        }

        Swal.fire({
            title: "ESTAS SEGURO?",
            text: "Esta acción no se podrá revertir",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Modificar",
            cancelButtonText: "Cancelar"
        }).then((result) => {
        if (result.isConfirmed) {
            formulario.submit(); 
        }
        });
    }
    </script>

    <% if ( typeof alertaExito !== 'undefined' && alertaExito) { %>
    <script>
        Swal.fire({
            icon: "success",
            title: "EXITOS!",
            text: "Se modificó la participación correctamente",
            });
    </script>
    <% } %>

    <% if ( typeof alertaError !== 'undefined' && alertaError) { %>
    <script>
        Swal.fire({
            icon: "error",
            title: "ERROR",
            text: "Algo salió mal :C",
            });
    </script>
    <% } %>
</body>
</html>


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <title>Ver y buscar participaciones</title>
</head>
<body>
    <header>
        <nav>
            <ul class="menuPrincipal">
                <a href="/participaciones">VOLVER</a>
            </ul>
        </nav>
    </header>
    <h1>VER Y BUSCAR PARTICIPACIONES</h1>
    <form action="/participaciones/verParticipaciones" method="GET">
        <input name="id" type="number" placeholder="ID de la participación" size="15">
        <button name="enviar" type="submit">BUSCAR</button>
    </form>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>ATLETA</th>
                <th>EVENTO</th>
                <th>AÑO</th>
                <th>MEDALLA</th>
            </tr>
        </thead>
        <tbody>
        <% if (participaciones.length === 0) { %>
            <tr>
                <td colspan="5" style="text-align: center;">No se encontraron participaciones</td>
            </tr>
        <% } else{ %>
        <% participaciones.forEach(participacion => { %>
            <tr>
                <td> <%= participacion.idparticipacion %></td>
                <td> <%= participacion.nombre %></td>
                <td> <%= participacion.descripcion %></td>
                <td> <%= participacion.anio %></td>
                <td> <%= participacion.medalla %></td>
            </tr>         
        <% }); %>
        <% } %>
        </tbody>
    </table>

    <% if ( typeof alertaError !== 'undefined' && alertaError) { %>
    <script>
        Swal.fire({
            icon: "error",
            title: "ERROR",
            text: "Algo salió mal :C",
            });
    </script>
    <% } %>
</body>
</html>

